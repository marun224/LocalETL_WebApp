---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Badge from '../components/ui/Badge.astro';
import Prose from '../components/ui/Prose.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../config/site.js';
import { BRAND } from '../config/brand';

const releases = (await getCollection('changelog')).sort(
  (a, b) => b.data.released.valueOf() - a.data.released.valueOf()
);

const rendered = await Promise.all(
  releases.map(async (r) => ({ entry: r, Content: (await render(r)).Content }))
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout>
  <PageHero
    eyebrow="Changelog"
    title="Releases"
    lede="What shipped, when, and what changed."
  />

  <Section>
    {
      rendered.length === 0 ? (
        <div class="mx-auto max-w-2xl">
          <div class="rounded-frame border border-line bg-raised p-8 text-center sm:p-12">
            <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-subtle">
              <Icon name="package-open" size={24} class="text-muted" />
            </span>

            <h2 class="mt-5 text-xl font-semibold text-ink">No releases yet</h2>

            <p class="mx-auto mt-4 max-w-lg leading-relaxed text-muted">
              {BRAND.name} has not shipped a first version. This page exists and is empty
              rather than not existing, because "there is nothing here yet" is a more useful
              answer than a 404 — and more honest than a fabricated v0.1 history.
            </p>

            <p class="mx-auto mt-4 max-w-lg leading-relaxed text-muted">
              The first release will appear here and on the repository at the same time.
            </p>

            <div class="mt-7 flex flex-wrap justify-center gap-3">
              <Button href={SITE.github} external>
                <Icon name="simple:github" size={17} />
                Watch the repository
              </Button>
              <Button href="/roadmap" variant="secondary">
                See what is being built
              </Button>
            </div>
          </div>

          <p class="mt-6 text-center text-sm text-faint">
            Watching the repository is the only way to be notified. There is no mailing list,
            because there is no tracking on this site.
          </p>
        </div>
      ) : (
        <div class="mx-auto max-w-3xl space-y-14">
          {rendered.map(({ entry, Content }) => (
            <article class="border-b border-line pb-14 last:border-0 last:pb-0">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-2xl font-semibold tracking-tight text-ink">
                  v{entry.data.version}
                </h2>
                <Badge tone={entry.data.kind === 'major' ? 'primary' : 'neutral'}>
                  {entry.data.kind}
                </Badge>
                <time
                  class="ml-auto text-sm text-faint"
                  datetime={entry.data.released.toISOString()}
                >
                  {fmt(entry.data.released)}
                </time>
              </div>

              <p class="mt-3 text-lg leading-relaxed text-muted">{entry.data.summary}</p>

              <Prose class="mt-6">
                <Content />
              </Prose>
            </article>
          ))}
        </div>
      )
    }
  </Section>
</BaseLayout>
