---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { MAIN_NAV } from '../config/nav';

// Flatten the nav so a lost visitor gets real destinations, not just "go home".
const suggestions = MAIN_NAV.flatMap((g) => g.items ?? (g.href ? [{ label: g.label, href: g.href }] : []));
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-sm tracking-[0.2em] text-primary">404</p>

    <h1 class="text-display mt-5 max-w-2xl text-ink">This page isn’t here</h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      Either it moved, or it never existed. The site is pre-launch, so some things you might
      expect to find genuinely do not exist yet.
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href="/">Back to the home page</Button>
      <Button href="/docs" variant="secondary">Documentation</Button>
    </div>

    <nav class="mt-14 w-full max-w-2xl border-t border-line pt-8" aria-label="Suggested pages">
      <h2 class="text-sm font-semibold text-ink">Or try one of these</h2>
      <ul class="mt-4 flex flex-wrap justify-center gap-2">
        {
          suggestions.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex items-center gap-1.5 rounded-btn border border-line bg-raised px-3.5 py-2 text-sm text-muted transition-colors hover:border-line-strong hover:text-ink"
              >
                {s.label}
                <Icon name="arrow-right" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>
