---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const SECTION_ORDER = ['Getting started', 'Building pipelines', 'Analysis', 'Operations'];

const sections = SECTION_ORDER.map((name) => ({
  name,
  items: docs.filter((d) => d.data.section === name).sort((a, b) => a.data.order - b.data.order),
})).filter((s) => s.items.length > 0);
---

<BaseLayout
  title="Documentation"
  description="Install it, connect a source, build a pipeline, query the result, and deploy it."
>
  <PageHero
    eyebrow="Docs"
    title="Documentation"
    lede="Written against the product as designed. Pre-launch, so treat it as a specification rather than a manual."
  />

  <Section>
    <div class="space-y-12">
      {
        sections.map((section) => (
          <div>
            <h2 class="text-xl font-semibold text-ink">{section.name}</h2>
            <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {section.items.map((item) => (
                <a
                  href={`/docs/${item.id}`}
                  class="group rounded-card border border-line bg-raised p-5 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-line-strong hover:shadow-lift"
                >
                  <h3 class="font-semibold text-ink">{item.data.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.data.description}</p>
                  <span class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
                    Read
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-14 rounded-card border border-line bg-subtle p-6">
      <h2 class="flex items-center gap-2.5 font-semibold text-ink">
        <Icon name="bot" size={18} class="text-primary" />
        Reading this with an AI agent?
      </h2>
      <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-muted">
        Every article is also published as plain Markdown at
        <code class="rounded bg-surface px-1.5 py-0.5 text-xs">/docs/&lt;slug&gt;.md</code>, and
        the whole site is summarised at
        <a href="/llms.txt" class="text-primary underline">/llms.txt</a> and
        <a href="/llms-full.txt" class="text-primary underline">/llms-full.txt</a>. No JavaScript
        needed, and no scraping a rendered page to get at the text.
      </p>
    </div>
  </Section>
</BaseLayout>
