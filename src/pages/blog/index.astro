---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Icon from '../../components/ui/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Writing about local-first data tooling, warehouse cost, pipeline design and migrations."
>
  <PageHero
    eyebrow="Blog"
    title="Writing"
    lede="Arguments about data tooling, mostly. No release notes yet, because there are no releases."
  />

  <Section>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <div class="space-y-3">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block rounded-card border border-line bg-raised p-6 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-line-strong hover:shadow-lift sm:p-7"
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                <time datetime={post.data.published.toISOString()}>
                  {fmt(post.data.published)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{post.data.minutes} min read</span>
              </div>

              <h2 class="mt-2.5 text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                {post.data.title}
              </h2>
              <p class="mt-2.5 leading-relaxed text-muted">{post.data.description}</p>

              <div class="mt-4 flex flex-wrap items-center gap-2">
                {post.data.tags.map((t) => (
                  <Badge>{t}</Badge>
                ))}
                <span class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-primary">
                  Read
                  <Icon name="arrow-right" size={14} />
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-card border border-line bg-subtle p-5">
          <h2 class="flex items-center gap-2 font-semibold text-ink">
            <Icon name="rss" size={16} class="text-primary" />
            Follow along
          </h2>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">
            There is no mailing list. There is a feed, which does not require giving us your
            email address.
          </p>
          <a
            href="/rss.xml"
            class="mt-3.5 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
          >
            RSS feed
            <Icon name="arrow-up-right" size={14} />
          </a>
        </div>

        <div class="mt-4 rounded-card border border-line bg-subtle p-5">
          <h2 class="flex items-center gap-2 font-semibold text-ink">
            <Icon name="bot" size={16} class="text-primary" />
            Plain Markdown
          </h2>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">
            Every post is also at <code class="text-xs">/blog/&lt;slug&gt;.md</code> for agents
            and fetch tools.
          </p>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
