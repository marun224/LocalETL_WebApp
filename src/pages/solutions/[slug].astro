---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import ProductFrame from '../../components/ui/ProductFrame.astro';
import { SOLUTIONS } from '../../data/solutions';

export function getStaticPaths() {
  return SOLUTIONS.map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

const { solution } = Astro.props;
const others = SOLUTIONS.filter((s) => s.slug !== solution.slug);
---

<BaseLayout title={solution.audience} description={solution.lede}>
  <PageHero eyebrow={solution.audience} title={solution.title} lede={solution.lede} disclose />

  <!-- The problem -->
  <Section>
    <SectionHeading
      eyebrow="The problem"
      title="What actually slows this down"
      lede="Stated the way you would state it, not the way a vendor would."
    />
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        solution.pain.map((p) => (
          <div class="rounded-card border border-line bg-subtle p-6">
            <h3 class="font-semibold text-ink">{p.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- The answer -->
  <Section tone="subtle">
    <SectionHeading eyebrow="The answer" title="What changes" />
    <div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
      {
        solution.answers.map((a) => (
          <div class="flex gap-4">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary-wash">
              <Icon name="check" size={17} class="text-primary" />
            </span>
            <div>
              <h3 class="font-semibold text-ink">{a.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{a.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Scenario -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="In practice" title={solution.scenario.title} />
        <ol class="mt-8 space-y-5">
          {
            solution.scenario.steps.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-line bg-subtle font-mono text-xs font-semibold text-primary">
                  {i + 1}
                </span>
                <p class="pt-0.5 leading-relaxed text-muted">{step}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <ProductFrame label={`${solution.slug}.pipeline`}>
          <pre
            class="overflow-x-auto font-mono text-[0.78rem] leading-[1.8] text-product-fg"><code><span class="text-product-muted"># {solution.scenario.title}</span>

<span class="text-product-accent">sources:</span>
  - postgres://replica/orders
  - s3://exports/*.parquet
  - file:./finance-2026-09.csv

<span class="text-product-accent">steps:</span>
  - join    <span class="text-product-muted">on customer_id</span>
  - filter  <span class="text-product-muted">period = current</span>
  - aggregate <span class="text-product-muted">by region, channel</span>

<span class="text-product-accent">schedule:</span> <span class="text-product-amber">"0 6 * * *"</span></code></pre>
        </ProductFrame>
        <p class="mt-3 text-center text-sm text-faint">
          Illustrative — pipeline format is not final.
        </p>
      </div>
    </div>
  </Section>

  <!-- When not to use it -->
  <Section tone="subtle">
    <div class="mx-auto max-w-3xl rounded-frame border border-line bg-raised p-8 sm:p-10">
      <div class="flex gap-4">
        <Icon name="triangle-alert" size={22} class="mt-0.5 shrink-0 text-warning" />
        <div>
          <h2 class="text-xl font-semibold text-ink">When this is the wrong tool</h2>
          <p class="mt-3 leading-relaxed text-muted">{solution.notFor}</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Other audiences -->
  <Section>
    <SectionHeading eyebrow="Also for" title="The other side of the same engine" align="center" />
    <div class="mx-auto mt-10 grid max-w-3xl gap-5 sm:grid-cols-2">
      {
        others.map((o) => (
          <a
            href={`/solutions/${o.slug}`}
            class="rounded-card border border-line bg-raised p-6 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-line-strong hover:shadow-lift"
          >
            <p class="text-eyebrow mb-2">{o.audience}</p>
            <p class="font-semibold text-ink">{o.title}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
              Read on
              <Icon name="arrow-right" size={15} />
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <Button href="/download" size="lg">Get started</Button>
    </div>
  </Section>
</BaseLayout>
