---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import Badge from '../components/ui/Badge.astro';

/**
 * A feature with a third element, `'planned'`, is not built yet and renders
 * with a "Planned" badge instead of a check. Everything else must be true of
 * the engine today — see docs/CLAIMS.md before adding a feature without it.
 */
type Feature = [title: string, body: string, status?: 'planned'];

const groups: { id: string; icon: string; label: string; lede: string; features: Feature[] }[] = [
  {
    id: 'ingest',
    icon: 'download',
    label: 'Ingest',
    lede: 'Read data where it already is, in the format it is already in.',
    features: [
      ['Direct source connections', 'Databases, lakehouse tables, object stores and REST APIs, read over their own protocols. No staging copy, no intermediate upload.'],
      ['Read in place', 'Point at a bucket or a folder and query the Parquet where it sits, with no copy first.'],
      ['Incremental loads', 'Save a watermark on each run and read only rows past it next time, so a nightly sync does not re-read history.'],
      ['Change data capture', 'Track inserts, updates and deletes at the source and propagate them, rather than rebuilding a table every night.', 'planned'],
      ['Credentials stay yours', 'Secrets are encrypted in your own workspace and referenced by name, never written into a pipeline. Connections originate from your network.'],
      ['Schema drift handling', 'A new column upstream is surfaced as a decision, not an unexplained failure at 3am.', 'planned'],
    ],
  },
  {
    id: 'transform',
    icon: 'workflow',
    label: 'Transform',
    lede: 'A visual canvas whose output you can always read.',
    features: [
      ['Compiles to readable SQL', 'Open any node and see exactly what will run. Not a proprietary plan, not generated Java — SQL you could have written.'],
      ['Swap in your own SQL', 'Disagree with a generated step? Replace it with a SQL node of your own. The canvas is a convenience, not a cage you cannot leave.'],
      ['Joins across systems', 'A Postgres table, a Parquet file and a REST API in a single query, without loading any of them into a warehouse first. Named SaaS connectors are planned.'],
      ['Validators with reject routing', 'Bad rows go to a reject output where you can inspect them, instead of being silently dropped or failing the run.'],
      ['Lineage between nodes', 'Every run records which node fed which, so an output traces back to the sources it came from. Column-level lineage is planned.'],
      ['Version control friendly', 'Pipelines are JSON text. They diff in a pull request and review like code, because they are code.'],
      ['Python escape hatch', 'When the canvas and SQL are the wrong tool, drop into a script node and keep going.', 'planned'],
    ],
  },
  {
    id: 'analyze',
    icon: 'bar-chart-3',
    label: 'Analyse',
    lede: 'Where extraction-only tools hand you off to something else.',
    features: [
      ['Pivots and aggregations', 'The spreadsheet work analysts actually do, over datasets a spreadsheet cannot open.'],
      ['Exports that fit downstream', 'Parquet, CSV, JSON, Excel or XML files, a bucket, or written straight back into Postgres, MySQL or SQLite.'],
      ['Plain-English questions', 'Ask in words, get SQL back, read it before it runs. The generated query is the feature, not a hidden step.', 'planned'],
      ['SQL editor', 'For when you already know what you want and typing it is faster than describing it.', 'planned'],
      ['Charts and dashboards', 'Build a view once, share it with the team, refresh it on a schedule.', 'planned'],
    ],
  },
  {
    id: 'operate',
    icon: 'settings-2',
    label: 'Run & operate',
    lede: 'What happens after the pipeline is built and you stop watching it.',
    features: [
      ['Scheduled and headless runs', 'Cron, interval or file-watch schedules, and any pipeline built into one standalone binary that fits into systemd, CI or whatever you already operate.'],
      ['Run history with row counts', 'Every run records its outcome, how long it took, and the rows each stage produced or rejected. "What actually happened" has an answer.'],
      ['Failures report the real error', 'A failed stage shows the compiled SQL it was running and the engine’s own message, not an opaque internal code.'],
      ['Per-node previews', 'See the data as it looked at each step, which is usually where the bug is.'],
      ['Uses every core', 'Each query runs in parallel across your cores without being told to.'],
    ],
  },
  {
    id: 'govern',
    icon: 'shield-check',
    label: 'Control & governance',
    lede: 'The reasons an enterprise security review says yes.',
    features: [
      ['No egress by design', 'No account, no telemetry, no licence ping. The software makes no outbound calls of its own.'],
      ['Air-gapped operation', 'Ordinary, not a special deployment mode: a built pipeline runs on a machine with no network at all.'],
      ['Your keys, your network', 'Credentials are never brokered through a third party, because there is no third party in the path.'],
      ['Roles in the web console', 'The console that runs pipelines on a server has token sign-in and two roles: one that runs pipelines and one that only reads.'],
      ['On-device AI', 'The assistant runs in-process. Prompts and schemas do not leave the machine unless you explicitly choose a hosted model.', 'planned'],
      ['Team governance', 'Shared connections and audit trails on the paid tiers, for teams that need them.', 'planned'],
    ],
  },
];
---

<BaseLayout>
  <PageHero
    eyebrow="Features"
    title="What it does today, and what comes next"
    lede="Most tools own one part of this list and hand you off for the rest. The point of putting them in one engine is that the handoff is where the time goes."
    disclose
  />

  <!-- Jump nav -->
  <div class="sticky top-16 z-40 border-b border-line bg-surface/90 backdrop-blur-md">
    <div class="container-page flex gap-1 overflow-x-auto py-3">
      {
        groups.map((g) => (
          <a
            href={`#${g.id}`}
            class="inline-flex shrink-0 items-center gap-2 rounded-btn px-3 py-2 text-sm text-muted transition-colors hover:bg-subtle hover:text-ink"
          >
            <Icon name={g.icon} size={15} class="text-primary" />
            {g.label}
          </a>
        ))
      }
    </div>
  </div>

  {
    groups.map((g, i) => (
      <Section id={g.id} tone={i % 2 === 1 ? 'subtle' : 'surface'}>
        <SectionHeading eyebrow={g.label} title={g.lede} />
        <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
          {g.features.map(([title, body, status]) => (
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                {status === 'planned' ? (
                  <Icon name="circle-dashed" size={16} class="shrink-0 text-faint" />
                ) : (
                  <Icon name="check" size={16} class="shrink-0 text-primary" />
                )}
                <h3 class="font-medium text-ink">{title}</h3>
                {status === 'planned' && <Badge>Planned</Badge>}
              </div>
              <p class="mt-2 pl-[26px] text-sm leading-relaxed text-muted">{body}</p>
            </div>
          ))}
        </div>
      </Section>
    ))
  }

  <Section>
    <div class="rounded-frame border border-line bg-raised p-8 text-center shadow-soft sm:p-12">
      <h2 class="text-title text-ink">See how it fits together</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">
        A feature list is a list. The architecture page shows where each of these actually runs,
        and what never leaves your machine.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <Button href="/how-it-works">How it works</Button>
        <Button href="/integrations" variant="secondary">Browse connectors</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
