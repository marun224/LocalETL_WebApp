---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProductFrame from '../components/ui/ProductFrame.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import ArchitectureDiagram from '../components/diagrams/ArchitectureDiagram.astro';
import { SITE } from '../config/site.js';
import { BRAND } from '../config/brand';
---

<BaseLayout>
  <PageHero
    eyebrow="Security"
    title="What leaves your network, precisely"
    lede="Written for the person who has to sign off on this, not for the person who has to be reassured by it."
  />

  <!-- The short answer -->
  <Section>
    <div class="rounded-frame border border-primary/30 bg-primary-wash p-8 sm:p-10">
      <h2 class="text-2xl font-semibold text-ink">The short answer</h2>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink/85">
        Nothing. {BRAND.name} makes no outbound network requests of its own. There is no account
        system, no telemetry, no licence check and no update ping in the core. The only
        connections it opens are to the data sources you configure, and it opens those from your
        machine.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-muted">
        The rest of this page is the detail behind that sentence, including the parts that are
        conditional.
      </p>
    </div>
  </Section>

  <!-- Data flow table -->
  <Section tone="subtle">
    <SectionHeading
      eyebrow="Data handling"
      title="Feature by feature"
      lede="Every capability that could conceivably transmit something, and what it actually does."
    />

    <div
      class="mt-10 overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label="Data handling by feature, scrollable table"
    >
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-line">
            <th class="py-3 pr-4 text-sm font-semibold text-ink">Feature</th>
            <th class="py-3 pr-4 text-sm font-semibold text-ink">Leaves your machine?</th>
            <th class="py-3 text-sm font-semibold text-ink">What exactly</th>
          </tr>
        </thead>
        <tbody>
          {
            [
              ['Pipeline execution', 'no', 'Runs in-process. Rows are read, transformed and written entirely on your hardware.'],
              ['Schema browsing', 'no', 'Table and column metadata is read from your source and held locally.'],
              ['Query results', 'no', 'Materialised to your disk or memory. Never uploaded.'],
              ['On-device AI assistant (planned)', 'no', 'Not built yet. The design: the model runs in-process, and prompts, schema and data stay local.'],
              ['Hosted AI model (opt-in)', 'conditional', 'Only if you explicitly configure one. Then your prompt and the schema context you approve go to the provider you chose. Off by default.'],
              ['Crash reports', 'no', 'Written to a local file. Sending one is a deliberate act by you.'],
              ['Update check', 'conditional', 'Off by default. If enabled, requests a version number and sends nothing but the request itself.'],
              ['Licence validation (paid tiers)', 'conditional', 'Paid tiers verify a licence key. Air-gapped licensing avoids this entirely — see below.'],
              ['Telemetry / analytics', 'no', 'There is none to disable.'],
            ].map(([feature, verdict, detail]) => (
              <tr class="border-b border-line align-top">
                <td class="py-4 pr-4 text-sm font-medium text-ink">{feature}</td>
                <td class="py-4 pr-4">
                  {verdict === 'no' ? (
                    <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-success/30 bg-success/10 px-2.5 py-1 text-xs font-medium text-success">
                      <Icon name="check" size={13} />
                      No
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-warning/30 bg-warning/10 px-2.5 py-1 text-xs font-medium text-ink">
                      <Icon name="triangle-alert" size={13} class="text-warning" />
                      Only if enabled
                    </span>
                  )}
                </td>
                <td class="py-4 text-sm leading-relaxed text-muted">{detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <!-- Architecture -->
  <Section>
    <SectionHeading
      eyebrow="Architecture"
      title="Why this is structural, not a setting"
      lede="A privacy policy can change. An architecture with no egress path has to be rewritten to change."
    />
    <div class="mt-10">
      <ProductFrame label="trust boundary">
        <ArchitectureDiagram />
      </ProductFrame>
    </div>
  </Section>

  <!-- Deployment -->
  <Section tone="subtle">
    <SectionHeading eyebrow="Deployment" title="Inside a restricted network" />
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        [
          ['Workstation', 'The desktop application on an analyst machine. Reaches only the sources that machine can already reach.'],
          ['Private server / VPC', 'The headless runner on your own instance. Nothing needs to be exposed to the internet.'],
          ['Container', 'Runs in your orchestration with no outbound egress rule required.'],
          ['Air-gapped', 'No network route out is needed at any point, including licensing. Not a special mode — just the absence of a requirement.'],
        ].map(([t, d]) => (
          <div class="rounded-card border border-line bg-raised p-5">
            <h3 class="font-semibold text-ink">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{d}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Credentials + honesty -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Credentials" title="Where secrets live" />
        <ul class="mt-6 space-y-4">
          {
            [
              ['Encrypted in your workspace', 'Secrets are stored AES-256-GCM encrypted in the workspace’s .etl folder and referenced from a pipeline by name, never written into it. The key sits beside them, so treat that folder like an SSH private key. There is deliberately no OS keychain: a workspace copied to a machine with no keychain and no network keeps working.'],
              ['Or from the environment', 'Reference an environment variable instead, so nothing is stored at all. Vault and cloud secret managers are planned.'],
              ['Never brokered', 'Credentials are never sent to a third party, because no third party is in the connection path.'],
              ['Redacted in logs and errors', 'Connection strings are masked wherever a pipeline reports a failure.'],
            ].map(([t, d]) => (
              <li class="flex gap-3.5">
                <Icon name="key-round" size={17} class="mt-1 shrink-0 text-primary" />
                <div>
                  <p class="font-medium text-ink">{t}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <SectionHeading eyebrow="Compliance" title="What we do not claim" />
        <div class="mt-6 rounded-card border border-line bg-subtle p-6">
          <p class="leading-relaxed text-ink">
            {BRAND.name} holds <strong class="font-semibold">no certifications</strong>. Not SOC 2,
            not ISO 27001, not HIPAA. No audit has been performed, because the product has not
            shipped.
          </p>
          <p class="mt-4 leading-relaxed text-muted">
            Plenty of pre-launch sites imply otherwise with a row of badges and a "compliance-ready"
            claim. If a vendor tells you their architecture makes you compliant, they are
            describing your obligations, which they cannot see.
          </p>
          <p class="mt-4 leading-relaxed text-muted">
            What the architecture does do is make several common requirements easier to satisfy —
            data residency, egress restriction, air-gapped operation — because data not leaving
            is the default rather than a configuration you have to get right.
          </p>
        </div>

        <h3 class="mt-10 text-lg font-semibold text-ink">Reporting a vulnerability</h3>
        <p class="mt-3 leading-relaxed text-muted">
          Email <a href={`mailto:${SITE.email.security}`} class="text-primary underline">{SITE.email.security}</a>.
          Please include reproduction steps. We will acknowledge, keep you updated, and credit you
          unless you would rather we did not.
        </p>
        <Button href="/contact" variant="secondary" class="mt-6">
          Security questionnaire? Get in touch
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
