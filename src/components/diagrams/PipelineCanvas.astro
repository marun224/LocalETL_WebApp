---
/**
 * The canvas → SQL visual.
 *
 * Hand-authored SVG, not a screenshot: the product does not exist yet and a
 * fake screenshot would be a claim. A diagram is honestly a diagram.
 *
 * The whole argument of the product is on this one image — a visual pipeline
 * on the left, the SQL it compiles to on the right. "Never a black box" is
 * only persuasive if you show the box open.
 */

interface NodeSpec {
  x: number;
  y: number;
  label: string;
  sub: string;
  kind: 'source' | 'transform' | 'sink';
}

const NODES: NodeSpec[] = [
  { x: 8, y: 14, label: 'postgres', sub: 'orders', kind: 'source' },
  { x: 8, y: 86, label: 's3', sub: 'customers.parquet', kind: 'source' },
  { x: 8, y: 158, label: 'stripe', sub: 'charges', kind: 'source' },
  { x: 176, y: 50, label: 'join', sub: 'on customer_id', kind: 'transform' },
  { x: 176, y: 140, label: 'filter', sub: 'created_at ≥ 2026', kind: 'transform' },
  { x: 330, y: 96, label: 'aggregate', sub: 'sum by region', kind: 'transform' },
];

const COLORS = {
  source: 'var(--c-product-accent)',
  transform: 'var(--c-product-violet)',
  sink: 'var(--c-product-amber)',
};

const W = 130;
const H = 46;
---

<div class="grid gap-4 lg:grid-cols-[1.05fr_1fr] lg:gap-5">
  <!-- Canvas -->
  <div class="rounded-card border border-product-border bg-[color-mix(in_srgb,var(--c-product-bg)_60%,black)] p-3">
    <p class="mb-2 px-1 font-mono text-[0.6875rem] uppercase tracking-wider text-product-muted">
      Canvas
    </p>
    {/* Scrolls rather than shrinks on narrow screens: scaled to 340px the
        node labels drop to ~7px and stop being readable. */}
    <div class="-mx-1 overflow-x-auto px-1">
    <svg
      viewBox="0 0 480 230"
      class="w-full min-w-[420px]"
      role="img"
      aria-label="A pipeline canvas: three sources — a Postgres orders table, a customers Parquet file on S3, and Stripe charges — flow into a join and a filter, then into an aggregate that sums by region."
    >
      <defs>
        <marker
          id="pc-arrow"
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--c-product-muted)" />
        </marker>
      </defs>

      <!-- edges, drawn first so nodes sit on top. Muted rather than border
           colour: at #222c38 the arrowheads were invisible against the canvas. -->
      <g
        fill="none"
        stroke="var(--c-product-muted)"
        stroke-width="1.5"
        opacity="0.6"
        marker-end="url(#pc-arrow)"
      >
        <path d="M138 37 C 158 37, 158 73, 176 73" />
        <path d="M138 109 C 158 109, 158 78, 176 78" />
        <path d="M138 181 C 158 181, 158 163, 176 163" />
        <path d="M306 73 C 320 73, 316 116, 330 119" />
        <path d="M306 163 C 320 163, 316 124, 330 121" />
      </g>

      <!-- nodes -->
      {
        NODES.map((n) => (
          <g>
            <rect
              x={n.x}
              y={n.y}
              width={W}
              height={H}
              rx="8"
              fill="var(--c-product-raised)"
              stroke={COLORS[n.kind]}
              stroke-width="1.4"
              opacity="0.98"
            />
            <rect x={n.x} y={n.y} width="3.5" height={H} rx="1.75" fill={COLORS[n.kind]} />
            <text
              x={n.x + 14}
              y={n.y + 19}
              font-family="var(--font-mono)"
              font-size="11.5"
              font-weight="500"
              fill="var(--c-product-fg)"
            >
              {n.label}
            </text>
            <text
              x={n.x + 14}
              y={n.y + 34}
              font-family="var(--font-mono)"
              font-size="9.5"
              fill="var(--c-product-muted)"
            >
              {n.sub}
            </text>
          </g>
        ))
      }

      <!-- output -->
      <rect
        x="330"
        y="14"
        width={W}
        height={H}
        rx="8"
        fill="var(--c-product-raised)"
        stroke="var(--c-product-amber)"
        stroke-width="1.4"
        stroke-dasharray="3 3"
        opacity="0.45"
      />
      <text
        x="344"
        y="42"
        font-family="var(--font-mono)"
        font-size="10"
        fill="var(--c-product-muted)"
      >
        + add destination
      </text>
    </svg>
    </div>
  </div>

  <!-- Generated SQL -->
  <div class="rounded-card border border-product-border bg-[color-mix(in_srgb,var(--c-product-bg)_60%,black)] p-3">
    <p class="mb-2 flex items-center gap-2 px-1 font-mono text-[0.6875rem] uppercase tracking-wider text-product-muted">
      Generated SQL
      <span class="rounded-full bg-product-accent/15 px-1.5 py-0.5 text-[0.625rem] normal-case tracking-normal text-product-accent">
        read-only
      </span>
    </p>
    <pre class="overflow-x-auto px-1 font-mono text-[0.78rem] leading-[1.75] text-product-fg"><code><span class="text-product-violet">SELECT</span>
  c.region,
  <span class="text-product-violet">COUNT</span>(<span class="text-product-violet">DISTINCT</span> o.order_id) <span class="text-product-violet">AS</span> orders,
  <span class="text-product-violet">SUM</span>(s.amount) / <span class="text-product-amber">100.0</span>    <span class="text-product-violet">AS</span> revenue
<span class="text-product-violet">FROM</span> postgres.orders o
<span class="text-product-violet">JOIN</span> read_parquet(<span class="text-product-amber">'s3://.../customers.parquet'</span>) c
  <span class="text-product-violet">ON</span> c.customer_id = o.customer_id
<span class="text-product-violet">JOIN</span> stripe.charges s
  <span class="text-product-violet">ON</span> s.order_id = o.order_id
<span class="text-product-violet">WHERE</span> o.created_at &gt;= <span class="text-product-amber">'2026-01-01'</span>
<span class="text-product-violet">GROUP BY</span> c.region
<span class="text-product-violet">ORDER BY</span> revenue <span class="text-product-violet">DESC</span>;</code></pre>
  </div>
</div>
