---
import { BRAND } from '../../config/brand';

export interface Props {
  class?: string;
  /** Mark only, no wordmark. */
  markOnly?: boolean;
}

const { class: className = '', markOnly = false } = Astro.props;
---

{/*
  The mark: a headrace — the channel that carries water TO the mill wheel.
  Three converging channels (many sources) narrow into one gate (the engine),
  which opens onto a wheel (the result). Ingest → transform → analyze, in one
  glyph. Strokes use currentColor so it inherits theme and hover state.
*/}
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="28"
    height="28"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
    class="shrink-0 text-primary"
  >
    <!-- three intake channels -->
    <path
      d="M2 7h9.5l4 4.5M2 16h9.5M2 25h9.5l4-4.5"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- the gate -->
    <path
      d="M15.5 11.5h3.2v9h-3.2z"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linejoin="round"
    />
    <!-- the wheel -->
    <circle cx="25" cy="16" r="5.4" stroke="currentColor" stroke-width="2.1" />
    <path d="M25 10.6v10.8M19.6 16h10.8" stroke="currentColor" stroke-width="1.5" opacity="0.55" />
  </svg>

  {
    !markOnly && (
      <span class="text-[1.0625rem] font-semibold tracking-tight text-ink">{BRAND.name}</span>
    )
  }
</span>
