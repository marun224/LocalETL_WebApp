---
export interface Props {
  tone?: 'neutral' | 'primary' | 'accent' | 'success' | 'warning';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  neutral: 'border-line bg-subtle text-muted',
  primary: 'border-primary/25 bg-primary-wash text-primary',
  // Amber on a light background fails contrast as text, so the accent badge
  // uses ink on a wash rather than amber text. See styleguide contrast notes.
  accent: 'border-accent/30 bg-accent-wash text-ink',
  success: 'border-success/25 bg-success/10 text-success',
  warning: 'border-warning/30 bg-warning/10 text-ink',
};
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium ${tones[tone]} ${className}`}
>
  <slot />
</span>
