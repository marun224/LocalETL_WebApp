---
/**
 * Theme toggle. ~350 bytes of inline JS, no framework island.
 *
 * Renders both icons and swaps visibility via CSS on [data-theme], so the
 * correct icon is already showing at first paint — no flash, no hydration.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-9 items-center justify-center rounded-btn text-muted transition-colors hover:bg-subtle hover:text-ink"
  aria-label="Switch colour theme"
>
  <svg
    class="size-[18px] [[data-theme='dark']_&]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    class="hidden size-[18px] [[data-theme='dark']_&]:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* Storage blocked: the toggle still works for this page view. */
    }
  });
</script>
