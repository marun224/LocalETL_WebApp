---
/**
 * Inline SVG icons, resolved at BUILD time from the Iconify datasets.
 *
 * The iconify packages are devDependencies: nothing ships to the browser
 * except the handful of `<path>` elements actually used. No icon font, no
 * sprite fetch, no runtime request — see CONTRIBUTING.md rule 2.
 *
 * Usage:  <Icon name="database" />           → lucide
 *         <Icon name="simple:postgresql" />  → simple-icons (brand marks)
 */
import lucide from '@iconify-json/lucide/icons.json';
import simple from '@iconify-json/simple-icons/icons.json';

export interface Props {
  name: string;
  size?: number | string;
  class?: string;
  /** Give the icon an accessible name. Omit for purely decorative icons. */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

const isBrand = name.startsWith('simple:');
const key = isBrand ? name.slice('simple:'.length) : name;
const set: any = isBrand ? simple : lucide;

const icon = set.icons[key];

if (!icon) {
  throw new Error(
    `Icon "${name}" not found in ${isBrand ? 'simple-icons' : 'lucide'}. ` +
      `Check the name at https://icones.js.org/.`
  );
}

const w = icon.width ?? set.width ?? 24;
const h = icon.height ?? set.height ?? 24;

// Brand marks from simple-icons are solid shapes with no stroke; they need
// fill:currentColor. Lucide icons carry their own stroke attributes.
const fill = isBrand ? 'currentColor' : 'none';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={`0 0 ${w} ${h}`}
  fill={fill}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>
