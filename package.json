{
  "name": "headrace-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Headrace — local-first ETL and analytics.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-icons.mjs && astro check && astro build && node scripts/check-external.mjs && node scripts/gen-headers.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:external": "node scripts/check-external.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "og": "node scripts/gen-og.mjs",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,json,md,mdx,css}\"",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "shot": "node scripts/screenshot.mjs",
    "astro": "astro",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:browsers": "node scripts/check-browsers.mjs",
    "rebrand": "node scripts/rebrand.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "axe-core": "^4.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@tailwindcss/oxide": true,
    "sharp": true
  }
}
